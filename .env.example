# Public hostname Caddy gets a certificate for. Use localhost for local runs.
DOMAIN=alt.example.org

# ACME contact address (optional, recommended for expiry notices).
ACME_EMAIL=

# Admin credentials. Without ADMIN_PASSWORD nothing can be uploaded at all:
# /new and /admin answer 401 and the store stays read-only.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional overrides.
#MAX_BLOB=5M
#LIST_PAGE_SIZE=50
#RATE_LIMIT=on
#RATE_LIMIT_MAX=60
#RATE_LIMIT_WINDOW=60
